# Copy to .env.local (test machine) or add in Vercel → Project → Settings → Environment Variables.

# REQUIRED: password for the import page (/admin). Without it, importing is disabled.
ADMIN_PASSWORD=

# Optional: extra secret for signing admin sessions (defaults to a hash of ADMIN_PASSWORD).
# Changing it (or the password) signs everyone out.
# SESSION_SECRET=

# Storage of the imported catalog (no database needed):
# - On Vercel: create a Blob store (Project → Storage → Create → Blob) and connect it to this
#   project. Vercel adds BLOB_READ_WRITE_TOKEN automatically; redeploy once afterwards.
# - Anywhere else (test machine, `npm run dev`): the catalog is saved in the .data/ folder.
# BLOB_READ_WRITE_TOKEN=

# The enhanced website, linked from legacy product pages ("See all … on the enhanced website").
NEXT_PUBLIC_ENHANCED_URL=https://inriver-web-app.vercel.app

# Public URL of the site (canonical URLs, sitemap, structured data). Detected automatically on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Quote requests: by default the quote form opens a pre-filled e-mail to this address.
NEXT_PUBLIC_QUOTE_EMAIL=sales@example.com

# Optional: POST quote requests as JSON to an endpoint (Formspree, CRM webhook, Power Automate, ...).
NEXT_PUBLIC_QUOTE_ENDPOINT=

# Optional: external checkout URL. When empty, the cart offers "Request a quote" instead.
NEXT_PUBLIC_CHECKOUT_URL=

# Image optimization: defaults to "true" on Vercel and "false" elsewhere.
# NEXT_IMAGE_OPTIMIZATION=true

# Image hosts from your Excel that should be optimized (resized, AVIF/WebP), comma separated.
# Images from other hosts are still shown, loaded directly from their source.
# IMAGE_REMOTE_HOSTS=assets.example.com,cdn.example.com
